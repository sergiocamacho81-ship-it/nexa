# Supabase — dashboard do projeto em Settings -> API / Settings -> Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Postgres via Supabase (Settings -> Database -> Connection string)
# DATABASE_URL: Transaction pooler (porta 6543, com ?pgbouncer=true) - usada em runtime
# DIRECT_URL: Direct connection (porta 5432) - usada só pelo Prisma Migrate
DATABASE_URL=
DIRECT_URL=

# SMTP (envio de email e campanhas)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
