generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  emailMessages  EmailMessage[]
  automations    Automation[]
  automationRuns AutomationRun[]
  campaigns      Campaign[]
  segments       Segment[]

  @@map("organizations")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Contact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  email          String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals              Deal[]
  activities         Activity[]
  tasks              Task[]
  emailMessages      EmailMessage[]
  campaignRecipients CampaignRecipient[]

  @@index([organizationId])
  @@index([companyId])
  @@map("contacts")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  domain         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]

  @@index([organizationId])
  @@map("companies")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  title          String
  value          Decimal?  @db.Decimal(12, 2)
  stage          DealStage @default(LEAD)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities    Activity[]
  tasks         Task[]
  emailMessages EmailMessage[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@map("deals")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  type           ActivityType
  content        String
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("activities")
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  contactId      String?    @map("contact_id") @db.Uuid
  companyId      String?    @map("company_id") @db.Uuid
  dealId         String?    @map("deal_id") @db.Uuid
  assigneeId     String?    @map("assignee_id") @db.Uuid
  title          String
  dueDate        DateTime?  @map("due_date")
  status         TaskStatus @default(PENDING)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("tasks")
}

enum EmailStatus {
  SENT
  FAILED
}

model EmailMessage {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  contactId      String?     @map("contact_id") @db.Uuid
  dealId         String?     @map("deal_id") @db.Uuid
  fromAddress    String      @map("from_address")
  toAddress      String      @map("to_address")
  subject        String
  body           String
  status         EmailStatus @default(SENT)
  error          String?
  sentAt         DateTime    @default(now()) @map("sent_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@map("email_messages")
}

// Automation engine
//
// An Automation fires when `triggerType` matches an event raised by the app
// (see lib/automation/triggers.ts for the known trigger strings). Its
// AutomationActions run in `order`; each action's `actionType` picks a
// handler from lib/automation/actions.ts. New trigger/action types are added
// there without any schema change, since both are just typed strings + a
// JSON config blob.
model Automation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  triggerType    String   @map("trigger_type")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      AutomationAction[]
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([organizationId, triggerType])
  @@map("automations")
}

model AutomationAction {
  id           String @id @default(uuid()) @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  order        Int    @default(0)
  actionType   String @map("action_type")
  actionConfig Json   @default("{}") @map("action_config")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_actions")
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
}

model AutomationRun {
  id             String              @id @default(uuid()) @db.Uuid
  automationId   String              @map("automation_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  status         AutomationRunStatus
  triggerPayload Json                @default("{}") @map("trigger_payload")
  resultLog      Json                @default("[]") @map("result_log")
  error          String?
  ranAt          DateTime            @default(now()) @map("ran_at")

  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([organizationId])
  @@map("automation_runs")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  segmentId      String?        @map("segment_id") @db.Uuid
  name           String
  subject        String
  body           String
  status         CampaignStatus @default(DRAFT)
  sentAt         DateTime?      @map("sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment      Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]

  @@index([organizationId])
  @@index([segmentId])
  @@map("campaigns")
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

model CampaignRecipient {
  id         String                  @id @default(uuid()) @db.Uuid
  campaignId String                  @map("campaign_id") @db.Uuid
  contactId  String                  @map("contact_id") @db.Uuid
  status     CampaignRecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?               @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@map("campaign_recipients")
}

// A Segment is a saved filter over Contacts, resolved live (not a static
// snapshot) whenever it's used — e.g. picking recipients for a Campaign.
// `filters` is a small structured shape (see lib/segments/filters.ts), not a
// free-form query language: companyId, hasEmail, createdAfter/Before.
model Segment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  filters        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("segments")
}
