generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  GRANDFATHERED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Outbound email is configured per organization, not at the platform
  // level — every org must set its own before Email/Campaigns can send.
  // Stored as plain text (no field-level encryption yet); access is gated
  // the same way every other org field is (RLS + app-layer membership
  // checks), not by any additional secrecy on this column.
  smtpHost     String? @map("smtp_host")
  smtpPort     Int?    @map("smtp_port")
  smtpSecure   Boolean @default(false) @map("smtp_secure")
  smtpUser     String? @map("smtp_user")
  smtpPassword String? @map("smtp_password")
  smtpFrom     String? @map("smtp_from")

  // Soft delete: set instead of a hard DELETE so an Owner can restore within
  // the retention window (see lib/soft-delete.ts). Every list query in the
  // app filters `deletedAt: null`; nothing purges rows itself — that's a
  // lazy sweep run when the Trash view is opened (see app/actions/trash.ts).
  deletedAt DateTime? @map("deleted_at")

  // Freemium billing. FREE is capped (see lib/plan-limits.ts); PRO and
  // GRANDFATHERED are both unlimited — GRANDFATHERED marks an org that gets
  // PRO-level access without a Stripe subscription (every org that existed
  // before billing shipped, kept free for good; see the migration that
  // introduced this column). The Stripe fields are null until a checkout
  // actually happens — that flow isn't wired up yet.
  planTier             PlanTier @default(FREE) @map("plan_tier")
  stripeCustomerId     String?  @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")

  // Default VAT rate (percent) applied to new invoices; copied onto each
  // Invoice at creation time so it stays fixed even if this later changes.
  // Null means no VAT line is shown. invoiceCounter is a per-org sequence
  // for Invoice.number, incremented inside the same transaction that
  // creates the invoice (see app/actions/invoices.ts).
  invoiceVatRate Decimal? @map("invoice_vat_rate") @db.Decimal(5, 2)
  invoiceCounter Int      @default(0) @map("invoice_counter")

  // Per-org sequence for Quote.number, incremented inside the same
  // transaction that creates the quote — same pattern as invoiceCounter.
  quoteCounter Int @default(0) @map("quote_counter")

  memberships    Membership[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  jobs           Job[]
  projects       Project[]
  timeEntries    TimeEntry[]
  materialUsages MaterialUsage[]
  activities     Activity[]
  tasks          Task[]
  emailMessages  EmailMessage[]
  automations    Automation[]
  automationRuns AutomationRun[]
  campaigns      Campaign[]
  segments       Segment[]
  products       Product[]
  quotes         Quote[]
  invoices       Invoice[]

  @@map("organizations")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum ContactLanguage {
  pt
  en
  fr
  de
  it
}

enum SwissCanton {
  AG
  AI
  AR
  BE
  BL
  BS
  FR
  GE
  GL
  GR
  JU
  LU
  NE
  NW
  OW
  SG
  SH
  SO
  SZ
  TG
  TI
  UR
  VD
  VS
  ZG
  ZH
}

model Contact {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  companyId         String?          @map("company_id") @db.Uuid
  firstName         String           @map("first_name")
  lastName          String?          @map("last_name")
  email             String?
  phone             String?
  preferredLanguage ContactLanguage? @map("preferred_language")
  city              String?
  canton            SwissCanton?
  // Address/country foundation — until now nothing on Contact recorded a
  // country at all, which blocks any cross-border logic before it can even
  // start. Deliberately plain fields here (not a nested address object or a
  // tax-specific shape) — VAT/tax-residence fields belong to the Swiss
  // compliance phase, not this foundation pass.
  addressLine       String?          @map("address_line")
  postalCode        String?          @map("postal_code")
  countryCode       String?          @map("country_code")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals              Deal[]
  jobs               Job[]
  projects           Project[]
  quotes             Quote[]
  activities         Activity[]
  tasks              Task[]
  emailMessages      EmailMessage[]
  campaignRecipients CampaignRecipient[]

  @@index([organizationId])
  @@index([companyId])
  @@map("contacts")
}

model Company {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  domain         String?
  // Address/country foundation — mirrors the same fields added to Contact,
  // for the same reason (see Contact). VAT/tax-residence fields belong to
  // the Swiss compliance phase, not this foundation pass.
  addressLine    String?      @map("address_line")
  city           String?
  postalCode     String?      @map("postal_code")
  canton         SwissCanton?
  countryCode    String?      @map("country_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  jobs         Job[]
  projects     Project[]
  quotes       Quote[]
  activities   Activity[]
  tasks        Task[]

  @@index([organizationId])
  @@map("companies")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  title          String
  value          Decimal?  @db.Decimal(12, 2)
  stage          DealStage @default(LEAD)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities    Activity[]
  tasks         Task[]
  emailMessages EmailMessage[]
  jobs          Job[]
  projects      Project[]
  quotes        Quote[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@map("deals")
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// The operational counterpart to Deal: Deal tracks progress toward WINNING a
// sale (terminal LEAD->...->WON/LOST pipeline); Job tracks progress
// DELIVERING the work once there's work to deliver. Deliberately a separate
// entity, not a Deal extension — see docs discussion: a single WON Deal can
// spawn multiple Jobs (e.g. an annual contract -> 12 monthly service jobs),
// and a Job can exist with no Deal at all (repeat customer, no sales cycle
// worth tracking). dealId is therefore optional both ways.
//
// UI-facing name is "Work Order" (see app/app/[orgSlug]/jobs/) — the nav
// already has an unrelated "Jobs" link (the Deal pipeline, relabeled for
// this product's users), so this entity is never shown to users as "Job" to
// avoid two different "Jobs" pointing at two different pages. projectId is
// independent of dealId — a Job can belong to a Project, originate from a
// Deal, both, or neither.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  title          String
  status         JobStatus @default(SCHEDULED)
  // Single date, no separate end/duration — a multi-day job just shows on
  // its start date for this first pass (see Calendar scoping). Nullable:
  // plenty of jobs are logged without ever being calendar-scheduled.
  scheduledAt    DateTime? @map("scheduled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  timeEntries    TimeEntry[]
  materialUsages MaterialUsage[]

  @@index([organizationId])
  @@index([dealId])
  @@index([projectId])
  @@index([companyId])
  @@index([contactId])
  @@map("jobs")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Groups multiple Jobs under one customer engagement (e.g. "Kitchen
// renovation" containing separate Work Orders for demolition, plumbing,
// electrical, drywall, painting). Optional on every side, same pattern as
// Job: a Project can originate from a Deal or not, and a Job can belong to
// a Project or stand alone. Invoice does NOT anchor to Project directly —
// billing across a whole project is a financial-domain concern for a later
// phase, not this one.
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  dealId         String?       @map("deal_id") @db.Uuid
  companyId      String?       @map("company_id") @db.Uuid
  contactId      String?       @map("contact_id") @db.Uuid
  title          String
  status         ProjectStatus @default(PLANNED)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  jobs         Job[]

  @@index([organizationId])
  @@index([dealId])
  @@index([companyId])
  @@index([contactId])
  @@map("projects")
}

// Standalone time tracking — logged hours against a Job (not a Task; for a
// trade business "3 hours on the sink install" maps to the unit of work,
// not a checklist item). jobId optional: general/admin time can be logged
// with no job attached. userId has no FK to auth.users, same deviation as
// Task.assigneeId (see docs/ARCHITECTURE.md §7) — RLS scopes by
// organization_id, not by this column.
//
// Deliberately not wired to Invoice in this pass — turning logged hours
// into invoice line items is a financial-domain concern for a later phase.
model TimeEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  jobId          String?   @map("job_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  date           DateTime  @default(now())
  hours          Decimal   @db.Decimal(6, 2)
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([jobId])
  @@map("time_entries")
}

// Standalone material/parts usage tracking — logged consumption against a Job,
// same pattern as TimeEntry (jobId optional). productId is optional: picking a
// catalog Product prefills description/unit/unitCost, but a free-text/custom
// entry is also allowed (same "product or custom item" pattern as
// InvoiceLineItem). unitCost tracks what the material cost the org, not what
// it's billed at — deliberately not wired to Invoice in this pass, same
// reasoning as TimeEntry.
model MaterialUsage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  jobId          String?   @map("job_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  description    String
  quantity       Decimal   @db.Decimal(10, 2)
  unit           String?
  unitCost       Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  date           DateTime  @default(now())
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([jobId])
  @@index([productId])
  @@map("material_usages")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  type           ActivityType
  content        String
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("activities")
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  contactId      String?    @map("contact_id") @db.Uuid
  companyId      String?    @map("company_id") @db.Uuid
  dealId         String?    @map("deal_id") @db.Uuid
  assigneeId     String?    @map("assignee_id") @db.Uuid
  title          String
  dueDate        DateTime?  @map("due_date")
  status         TaskStatus @default(PENDING)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("tasks")
}

enum EmailStatus {
  SENT
  FAILED
}

model EmailMessage {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  contactId      String?     @map("contact_id") @db.Uuid
  dealId         String?     @map("deal_id") @db.Uuid
  fromAddress    String      @map("from_address")
  toAddress      String      @map("to_address")
  subject        String
  body           String
  status         EmailStatus @default(SENT)
  error          String?
  sentAt         DateTime    @default(now()) @map("sent_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@map("email_messages")
}

// Automation engine
//
// An Automation fires when `triggerType` matches an event raised by the app
// (see lib/automation/triggers.ts for the known trigger strings). Its
// AutomationActions run in `order`; each action's `actionType` picks a
// handler from lib/automation/actions.ts. New trigger/action types are added
// there without any schema change, since both are just typed strings + a
// JSON config blob.
model Automation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  triggerType    String    @map("trigger_type")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      AutomationAction[]
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([organizationId, triggerType])
  @@map("automations")
}

model AutomationAction {
  id           String @id @default(uuid()) @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  order        Int    @default(0)
  actionType   String @map("action_type")
  actionConfig Json   @default("{}") @map("action_config")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_actions")
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
}

model AutomationRun {
  id             String              @id @default(uuid()) @db.Uuid
  automationId   String              @map("automation_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  status         AutomationRunStatus
  triggerPayload Json                @default("{}") @map("trigger_payload")
  resultLog      Json                @default("[]") @map("result_log")
  error          String?
  ranAt          DateTime            @default(now()) @map("ran_at")

  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([organizationId])
  @@map("automation_runs")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  segmentId      String?        @map("segment_id") @db.Uuid
  name           String
  subject        String
  body           String
  status         CampaignStatus @default(DRAFT)
  sentAt         DateTime?      @map("sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment      Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]

  @@index([organizationId])
  @@index([segmentId])
  @@map("campaigns")
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

model CampaignRecipient {
  id         String                  @id @default(uuid()) @db.Uuid
  campaignId String                  @map("campaign_id") @db.Uuid
  contactId  String                  @map("contact_id") @db.Uuid
  status     CampaignRecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?               @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@map("campaign_recipients")
}

// A Segment is a saved filter over Contacts, resolved live (not a static
// snapshot) whenever it's used — e.g. picking recipients for a Campaign.
// `filters` is a small structured shape (see lib/segments/filters.ts), not a
// free-form query language: companyId, hasEmail, createdAfter/Before.
model Segment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  filters        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("segments")
}

// A Product is a catalog entry (a service or part with a default price) a
// solo tradesperson reuses across jobs — picking one on an invoice line
// item just prefills description/unitPrice, it doesn't link the two
// afterwards, so editing or deleting a Product never changes an invoice
// that already used it.
model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  unitPrice      Decimal   @map("unit_price") @db.Decimal(10, 2)
  unit           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems      InvoiceLineItem[]
  quoteLineItems QuoteLineItem[]
  materialUsages MaterialUsage[]

  @@index([organizationId])
  @@map("products")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

// Quote.number is unique per org, assigned sequentially from
// Organization.quoteCounter (same pattern as Invoice.number). Created from a
// Deal (see createQuoteForDeal in app/actions/quotes.ts), copying its
// company/contact at creation time — same "operational record outlives its
// origin" reasoning as Job/Project. validUntil is display-only in this pass:
// nothing purges or auto-expires a quote past that date (no cron infra yet,
// same limitation as Trash's lazy purge).
model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  dealId         String?     @map("deal_id") @db.Uuid
  companyId      String?     @map("company_id") @db.Uuid
  contactId      String?     @map("contact_id") @db.Uuid
  number         Int
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?   @map("valid_until")
  notes          String?
  vatRate        Decimal?    @map("vat_rate") @db.Decimal(5, 2)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  // Persisted, server-computed totals — same recalculation-on-every-line-item
  // -change pattern as Invoice (see recalculateQuoteTotals in
  // app/actions/quotes.ts), reusing the same computeInvoiceTotals arithmetic.
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  vatAmount Decimal @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lineItems    QuoteLineItem[]
  invoices     Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([dealId])
  @@index([companyId])
  @@index([contactId])
  @@map("quotes")
}

// Snapshot line item, same pattern as InvoiceLineItem — no organizationId of
// its own; RLS scopes it via the parent Quote.
model QuoteLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_line_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

// Invoice.number is unique per org, assigned sequentially from
// Organization.invoiceCounter. jobId is optional and SetNull on delete —
// an invoice is a financial record that must survive its Job being
// purged from Trash after the 30-day retention window. Anchored to Job,
// not Deal directly — Job is the operational "what is this invoice for"
// concept; Deal (if any) is reachable transitively via Job.dealId. quoteId
// is optional and SetNull on delete, set only when the invoice was created
// via "Convert to Invoice" from an accepted Quote (see convertQuoteToInvoice
// in app/actions/quotes.ts) — traceability only, not every invoice has one.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  jobId          String?       @map("job_id") @db.Uuid
  quoteId        String?       @map("quote_id") @db.Uuid
  number         Int
  status         InvoiceStatus @default(DRAFT)
  vatRate        Decimal?      @map("vat_rate") @db.Decimal(5, 2)
  issueDate      DateTime      @default(now()) @map("issue_date")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  // Persisted, server-computed totals — recalculated inside the same
  // transaction as every line-item add/remove (see recalculateInvoiceTotals
  // in app/actions/invoices.ts). Never derive these by re-summing line items
  // in a page/component: that was the previous approach (float conversion on
  // every render, no stored source of truth) and is exactly what this exists
  // to replace.
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  vatAmount Decimal @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote        Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([jobId])
  @@index([quoteId])
  @@map("invoices")
}

// A line item is a snapshot (description/quantity/unitPrice copied in at
// creation time), not a live reference — so it has no organizationId of
// its own; RLS scopes it via the parent Invoice, same pattern as
// AutomationAction under Automation.
model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_line_items")
}
