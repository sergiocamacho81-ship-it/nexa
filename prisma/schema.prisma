generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  GRANDFATHERED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Outbound email is configured per organization, not at the platform
  // level — every org must set its own before Email/Campaigns can send.
  // Stored as plain text (no field-level encryption yet); access is gated
  // the same way every other org field is (RLS + app-layer membership
  // checks), not by any additional secrecy on this column.
  smtpHost     String?  @map("smtp_host")
  smtpPort     Int?     @map("smtp_port")
  smtpSecure   Boolean  @default(false) @map("smtp_secure")
  smtpUser     String?  @map("smtp_user")
  smtpPassword String?  @map("smtp_password")
  smtpFrom     String?  @map("smtp_from")

  // Soft delete: set instead of a hard DELETE so an Owner can restore within
  // the retention window (see lib/soft-delete.ts). Every list query in the
  // app filters `deletedAt: null`; nothing purges rows itself — that's a
  // lazy sweep run when the Trash view is opened (see app/actions/trash.ts).
  deletedAt DateTime? @map("deleted_at")

  // Freemium billing. FREE is capped (see lib/plan-limits.ts); PRO and
  // GRANDFATHERED are both unlimited — GRANDFATHERED marks an org that gets
  // PRO-level access without a Stripe subscription (every org that existed
  // before billing shipped, kept free for good; see the migration that
  // introduced this column). The Stripe fields are null until a checkout
  // actually happens — that flow isn't wired up yet.
  planTier             PlanTier @default(FREE) @map("plan_tier")
  stripeCustomerId     String?  @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")

  // Default VAT rate (percent) applied to new invoices; copied onto each
  // Invoice at creation time so it stays fixed even if this later changes.
  // Null means no VAT line is shown. invoiceCounter is a per-org sequence
  // for Invoice.number, incremented inside the same transaction that
  // creates the invoice (see app/actions/invoices.ts).
  invoiceVatRate Decimal? @db.Decimal(5, 2) @map("invoice_vat_rate")
  invoiceCounter Int      @default(0) @map("invoice_counter")

  memberships    Membership[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  jobs           Job[]
  activities     Activity[]
  tasks          Task[]
  emailMessages  EmailMessage[]
  automations    Automation[]
  automationRuns AutomationRun[]
  campaigns      Campaign[]
  segments       Segment[]
  products       Product[]
  invoices       Invoice[]

  @@map("organizations")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum ContactLanguage {
  pt
  en
  fr
  de
  it
}

enum SwissCanton {
  AG
  AI
  AR
  BE
  BL
  BS
  FR
  GE
  GL
  GR
  JU
  LU
  NE
  NW
  OW
  SG
  SH
  SO
  SZ
  TG
  TI
  UR
  VD
  VS
  ZG
  ZH
}

model Contact {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  companyId         String?          @map("company_id") @db.Uuid
  firstName         String           @map("first_name")
  lastName          String?          @map("last_name")
  email             String?
  phone             String?
  preferredLanguage ContactLanguage? @map("preferred_language")
  city              String?
  canton            SwissCanton?
  // Address/country foundation — until now nothing on Contact recorded a
  // country at all, which blocks any cross-border logic before it can even
  // start. Deliberately plain fields here (not a nested address object or a
  // tax-specific shape) — VAT/tax-residence fields belong to the Swiss
  // compliance phase, not this foundation pass.
  addressLine       String?          @map("address_line")
  postalCode        String?          @map("postal_code")
  countryCode       String?          @map("country_code")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals              Deal[]
  jobs                Job[]
  activities         Activity[]
  tasks              Task[]
  emailMessages      EmailMessage[]
  campaignRecipients CampaignRecipient[]

  @@index([organizationId])
  @@index([companyId])
  @@map("contacts")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  domain         String?
  // Address/country foundation — mirrors the same fields added to Contact,
  // for the same reason (see Contact). VAT/tax-residence fields belong to
  // the Swiss compliance phase, not this foundation pass.
  addressLine    String?     @map("address_line")
  city           String?
  postalCode     String?     @map("postal_code")
  canton         SwissCanton?
  countryCode    String?     @map("country_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  jobs         Job[]
  activities   Activity[]
  tasks        Task[]

  @@index([organizationId])
  @@map("companies")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  title          String
  value          Decimal?  @db.Decimal(12, 2)
  stage          DealStage @default(LEAD)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities    Activity[]
  tasks         Task[]
  emailMessages EmailMessage[]
  jobs          Job[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@map("deals")
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// The operational counterpart to Deal: Deal tracks progress toward WINNING a
// sale (terminal LEAD->...->WON/LOST pipeline); Job tracks progress
// DELIVERING the work once there's work to deliver. Deliberately a separate
// entity, not a Deal extension — see docs discussion: a single WON Deal can
// spawn multiple Jobs (e.g. an annual contract -> 12 monthly service jobs),
// and a Job can exist with no Deal at all (repeat customer, no sales cycle
// worth tracking). dealId is therefore optional both ways.
//
// No dedicated create/edit UI exists yet for Job as of this foundation pass
// — until one does, createInvoiceForDeal (app/actions/invoices.ts)
// find-or-creates a Job per Deal so Invoice always has something real to
// anchor to.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  title          String
  status         JobStatus @default(SCHEDULED)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoices     Invoice[]

  @@index([organizationId])
  @@index([dealId])
  @@index([companyId])
  @@index([contactId])
  @@map("jobs")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  type           ActivityType
  content        String
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("activities")
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  contactId      String?    @map("contact_id") @db.Uuid
  companyId      String?    @map("company_id") @db.Uuid
  dealId         String?    @map("deal_id") @db.Uuid
  assigneeId     String?    @map("assignee_id") @db.Uuid
  title          String
  dueDate        DateTime?  @map("due_date")
  status         TaskStatus @default(PENDING)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("tasks")
}

enum EmailStatus {
  SENT
  FAILED
}

model EmailMessage {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  contactId      String?     @map("contact_id") @db.Uuid
  dealId         String?     @map("deal_id") @db.Uuid
  fromAddress    String      @map("from_address")
  toAddress      String      @map("to_address")
  subject        String
  body           String
  status         EmailStatus @default(SENT)
  error          String?
  sentAt         DateTime    @default(now()) @map("sent_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@map("email_messages")
}

// Automation engine
//
// An Automation fires when `triggerType` matches an event raised by the app
// (see lib/automation/triggers.ts for the known trigger strings). Its
// AutomationActions run in `order`; each action's `actionType` picks a
// handler from lib/automation/actions.ts. New trigger/action types are added
// there without any schema change, since both are just typed strings + a
// JSON config blob.
model Automation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  triggerType    String   @map("trigger_type")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      AutomationAction[]
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([organizationId, triggerType])
  @@map("automations")
}

model AutomationAction {
  id           String @id @default(uuid()) @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  order        Int    @default(0)
  actionType   String @map("action_type")
  actionConfig Json   @default("{}") @map("action_config")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_actions")
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
}

model AutomationRun {
  id             String              @id @default(uuid()) @db.Uuid
  automationId   String              @map("automation_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  status         AutomationRunStatus
  triggerPayload Json                @default("{}") @map("trigger_payload")
  resultLog      Json                @default("[]") @map("result_log")
  error          String?
  ranAt          DateTime            @default(now()) @map("ran_at")

  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([organizationId])
  @@map("automation_runs")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  segmentId      String?        @map("segment_id") @db.Uuid
  name           String
  subject        String
  body           String
  status         CampaignStatus @default(DRAFT)
  sentAt         DateTime?      @map("sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment      Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]

  @@index([organizationId])
  @@index([segmentId])
  @@map("campaigns")
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

model CampaignRecipient {
  id         String                  @id @default(uuid()) @db.Uuid
  campaignId String                  @map("campaign_id") @db.Uuid
  contactId  String                  @map("contact_id") @db.Uuid
  status     CampaignRecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?               @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@map("campaign_recipients")
}

// A Segment is a saved filter over Contacts, resolved live (not a static
// snapshot) whenever it's used — e.g. picking recipients for a Campaign.
// `filters` is a small structured shape (see lib/segments/filters.ts), not a
// free-form query language: companyId, hasEmail, createdAfter/Before.
model Segment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  filters        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("segments")
}

// A Product is a catalog entry (a service or part with a default price) a
// solo tradesperson reuses across jobs — picking one on an invoice line
// item just prefills description/unitPrice, it doesn't link the two
// afterwards, so editing or deleting a Product never changes an invoice
// that already used it.
model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  unitPrice      Decimal   @db.Decimal(10, 2) @map("unit_price")
  unit           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems    InvoiceLineItem[]

  @@index([organizationId])
  @@map("products")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

// Invoice.number is unique per org, assigned sequentially from
// Organization.invoiceCounter. jobId is optional and SetNull on delete —
// an invoice is a financial record that must survive its Job being
// purged from Trash after the 30-day retention window. Anchored to Job,
// not Deal directly — Job is the operational "what is this invoice for"
// concept; Deal (if any) is reachable transitively via Job.dealId.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  jobId          String?       @map("job_id") @db.Uuid
  number         Int
  status         InvoiceStatus @default(DRAFT)
  vatRate        Decimal?      @db.Decimal(5, 2) @map("vat_rate")
  issueDate      DateTime      @default(now()) @map("issue_date")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  // Persisted, server-computed totals — recalculated inside the same
  // transaction as every line-item add/remove (see recalculateInvoiceTotals
  // in app/actions/invoices.ts). Never derive these by re-summing line items
  // in a page/component: that was the previous approach (float conversion on
  // every render, no stored source of truth) and is exactly what this exists
  // to replace.
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  vatAmount Decimal @default(0) @db.Decimal(12, 2) @map("vat_amount")
  total     Decimal @default(0) @db.Decimal(12, 2)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([jobId])
  @@map("invoices")
}

// A line item is a snapshot (description/quantity/unitPrice copied in at
// creation time), not a live reference — so it has no organizationId of
// its own; RLS scopes it via the parent Invoice, same pattern as
// AutomationAction under Automation.
model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_line_items")
}
